                        <TextBlock x:Name="TxtCheckModalBody" Text="Detalhes da auditoria..." FontSize="12" Foreground="#D1D5DB" TextWrapping="Wrap" LineHeight="18"/>
                    </Border>

                    <Button Content="FECHAR" Style="{StaticResource CheatNeonButton}" HorizontalAlignment="Right" Padding="20,8" Click="BtnCloseCheckModal_Click"/>
                </StackPanel>
            </Border>

            <!-- MODAL 4: ATUALIZAÇÃO DISPONÍVEL (AUTO-UPDATER) -->
            <Border x:Name="ModalUpdate" Width="560" Background="#0A0E17" BorderBrush="#00FF66" BorderThickness="1.5" CornerRadius="10" Padding="22" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀 NOVA ATUALIZAÇÃO DISPONÍVEL!" FontWeight="Bold" FontSize="15" Foreground="#00FF66"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#0E2319" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="4" Padding="8,2">
                            <TextBlock x:Name="TxtNewVersionBadge" Text="v1.0.1 DISPONÍVEL" FontSize="10" FontWeight="Bold" Foreground="#00FF66"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="TxtUpdateSubtitle" Text="Uma nova versão oficial do ErreJota Matrix Optimizer Pro foi detectada:" FontSize="11" Foreground="#8B949E" Margin="0,0,0,12"/>

                    <!-- Card de Versões e Changelog -->
                    <Border Background="#0E1420" BorderBrush="#1C273B" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Versão Atual: " FontSize="11" Foreground="#8B949E"/>
                                    <TextBlock Text="v1.0.0" FontWeight="Bold" FontSize="11" Foreground="#FF5555" Margin="0,0,12,0"/>
                                    <TextBlock Text="Nova Versão: " FontSize="11" Foreground="#8B949E"/>
                                    <TextBlock x:Name="TxtNewVersionTarget" Text="v1.0.1" FontWeight="Bold" FontSize="11" Foreground="#00FF66"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtUpdateDate" Text="Data: 18/10/2026" FontSize="10" Foreground="#8B949E" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="NOVIDADES DA VERSÃO:" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,4,0,4"/>
                            <TextBlock x:Name="TxtUpdateChangelog" Text="• Otimizações de Kernel atualizadas&#x0a;• Correções e melhorias de desempenho FiveM" FontSize="11" Foreground="#D1D5DB" TextWrapping="Wrap" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <!-- Barra de Progresso do Download -->
                    <StackPanel x:Name="PanelUpdateProgress" Visibility="Collapsed" Margin="0,0,0,14">
                        <Grid Margin="0,0,0,4">
                            <TextBlock x:Name="TxtUpdateProgressLabel" Text="Baixando atualização com segurança..." FontSize="11" Foreground="#00E5FF"/>
                            <TextBlock x:Name="TxtUpdateProgressPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="BarUpdateProgress" Height="8" Maximum="100" Value="0" Foreground="#00FF66" Background="#18202E" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Botões -->
                    <Grid x:Name="PanelUpdateButtons">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnApplyUpdateNow" Grid.Column="0" Content="BAIXAR &amp; ATUALIZAR AGORA" Style="{StaticResource CheatNeonButton}" Margin="0,0,6,0" Click="BtnApplyUpdateNow_Click"/>
                        <Button Grid.Column="1" Content="DEPOIS" Style="{StaticResource CheatDarkButton}" Margin="6,0,0,0" Click="BtnCancelUpdate_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>

    </Grid>
</Window>
