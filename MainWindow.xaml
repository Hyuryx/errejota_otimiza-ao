<Window x:Class="ErrejotaMatrixOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ErrejotaMatrixOptimizer"
        mc:Ignorable="d"
        Title="ERREJOTA MATRIX OPTIMIZER PRO" Height="860" Width="1280"
        Icon="icon/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#07090E"
        BorderBrush="#00FF66"
        BorderThickness="1"
        FontFamily="Segoe UI, Consolas, Arial">

    <Window.Resources>
        <!-- Cores Estilo Cheat Loader Neon Matrix -->
        <SolidColorBrush x:Key="NeonGreen" Color="#00FF66"/>
        <SolidColorBrush x:Key="NeonCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="NeonYellow" Color="#FFB800"/>
        <SolidColorBrush x:Key="NeonRed" Color="#FF3366"/>
        <SolidColorBrush x:Key="BgDark" Color="#07090E"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#0A0E15"/>
        <SolidColorBrush x:Key="CardBg" Color="#0E131C"/>
        <SolidColorBrush x:Key="CardBorder" Color="#182232"/>
        <SolidColorBrush x:Key="TextWhite" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B949E"/>

        <!-- ESTILO TOGGLE SWITCH DESLIZANTE MODERNO -->
        <Style x:Key="CheatToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Border x:Name="Track" Grid.Column="1" Width="42" Height="22" Background="#18202E" 
                                    BorderBrush="#253247" BorderThickness="1" CornerRadius="11">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#4B5563" 
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0D2E1A"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00FF66"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#00FF66"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00FF66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO TOGGLE SWITCH CIANO -->
        <Style x:Key="CyanToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource CheatToggleSwitch}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="42" Height="22" Background="#18202E" 
                                    BorderBrush="#253247" BorderThickness="1" CornerRadius="11">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#4B5563" 
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0B2A36"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#00E5FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO CHEAT LOADER NEON VERDE -->
        <Style x:Key="CheatNeonButton" TargetType="Button">
            <Setter Property="Background" Value="#0E2316"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="BorderBrush" Value="#00FF66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00FF66"/>
                                <Setter Property="Foreground" Value="#07090E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO CHEAT CIANO -->
        <Style x:Key="CheatCyanButton" TargetType="Button" BasedOn="{StaticResource CheatNeonButton}">
            <Setter Property="Background" Value="#0A222C"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#07090E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO CHEAT AMARELO -->
        <Style x:Key="CheatYellowButton" TargetType="Button" BasedOn="{StaticResource CheatNeonButton}">
            <Setter Property="Background" Value="#221C0A"/>
            <Setter Property="Foreground" Value="#FFB800"/>
            <Setter Property="BorderBrush" Value="#FFB800"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFB800"/>
                                <Setter Property="Foreground" Value="#07090E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO CHEAT DARK / SECUNDÁRIO -->
        <Style x:Key="CheatDarkButton" TargetType="Button" BasedOn="{StaticResource CheatNeonButton}">
            <Setter Property="Background" Value="#121824"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderBrush" Value="#202A3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1C273B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO ITEM MENU LATERAL -->
        <Style x:Key="SidebarNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,0">
                            <Grid>
                                <Rectangle x:Name="ActiveIndicator" Width="3" Height="20" Fill="#00FF66" 
                                           HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#121824"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#00FF66"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>  <!-- Header / Barra de Título -->
            <RowDefinition Height="*"/>   <!-- Corpo: Menu Lateral + Cards -->
            <RowDefinition Height="160"/> <!-- Terminal Matrix Flutuante -->
            <RowDefinition Height="28"/>  <!-- Rodapé Fixo com Copyright -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. HEADER / BARRA DE TÍTULO -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#090D14" BorderBrush="#16202E" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0D2E1A" BorderBrush="#00FF66" BorderThickness="1.5" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="icon/1.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ERREJOTA // MATRIX OPTIMIZER PRO" FontWeight="Bold" FontSize="14" Foreground="#00FF66"/>
                            <Border Background="#102619" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.1.0" FontSize="9" FontWeight="Bold" Foreground="#00FF66"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="ELITE GAMER KERNEL &amp; ANTI-GARGALO ENGINE" FontSize="10" Foreground="#8B949E"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status do Hardware ao Vivo no Topo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#101724" BorderBrush="#1C283B" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HARDWARE: " FontSize="10" FontWeight="Bold" Foreground="#8B949E"/>
                            <TextBlock x:Name="TxtHeaderHardware" Text="Ryzen 9 5950X | RTX 4070 Ti | 32GB" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                        </StackPanel>
                    </Border>

                    <Button Content="—" Width="34" Height="28" Background="Transparent" Foreground="#8B949E" BorderThickness="0" FontSize="13" Click="BtnMinimize_Click" Cursor="Hand"/>
                    <Button Content="✕" Width="34" Height="28" Background="Transparent" Foreground="#FF5555" BorderThickness="0" FontSize="13" Click="BtnClose_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. CORPO PRINCIPAL (MENU LATERAL + CARDS) -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/> <!-- Sidebar Lateral com Badges -->
                <ColumnDefinition Width="*"/>   <!-- Área de Cards das Abas -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR LATERAL COM BADGES DINÂMICOS -->
            <Border Grid.Column="0" Background="#080C12" BorderBrush="#16202E" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12">
                        <TextBlock Text="MÓDULOS GAMER" FontSize="10" FontWeight="Bold" Foreground="#4B5563" Margin="16,6,0,4"/>

                        <!-- 1. Geral & Kernel -->
                        <RadioButton x:Name="NavSupreme" Style="{StaticResource SidebarNavButton}" IsChecked="True" Checked="Nav_Checked">
                            <Grid Width="185">
                                <TextBlock Text="🚀 Geral &amp; Kernel" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <Border x:Name="BadgeSupreme" HorizontalAlignment="Right" Background="#112B1C" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBadgeSupreme" Text="✔ OK" FontSize="9" FontWeight="Bold" Foreground="#00FF66"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- 2. Anti-Gargalo FiveM -->
                        <RadioButton x:Name="NavAntiFivem" Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked">
                            <Grid Width="185">
                                <TextBlock Text="⚡ Anti-Gargalo FiveM" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <Border x:Name="BadgeAntiFivem" HorizontalAlignment="Right" Background="#112B1C" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBadgeAntiFivem" Text="✔ OK" FontSize="9" FontWeight="Bold" Foreground="#00FF66"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- 3. Super Resolução -->
                        <RadioButton x:Name="NavDownscale" Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked">
                            <Grid Width="185">
                                <TextBlock Text="🖥️ Super Resolução" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <Border x:Name="BadgeDownscale" HorizontalAlignment="Right" Background="#112B1C" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBadgeDownscale" Text="✔ OK" FontSize="9" FontWeight="Bold" Foreground="#00FF66"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- 4. Lançador Gamer Pro & FiveM -->
                        <RadioButton x:Name="NavLauncher" Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked">
                            <Grid Width="185">
                                <TextBlock Text="🎮 Lançador Gamer Pro" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <Border x:Name="BadgeLauncher" HorizontalAlignment="Right" Background="#0C2530" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBadgeLauncher" Text="TURBO" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <TextBlock Text="SISTEMA &amp; SEGURANÇA" FontSize="10" FontWeight="Bold" Foreground="#4B5563" Margin="16,16,0,4"/>

                        <!-- 5. Limpeza Blindada -->
                        <RadioButton x:Name="NavCleaning" Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked">
                            <Grid Width="185">
                                <TextBlock Text="🧹 Limpeza Blindada" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <Border x:Name="BadgeCleaning" HorizontalAlignment="Right" Background="#241E0A" BorderBrush="#FFB800" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBadgeCleaning" Text="LIMPO" FontSize="9" FontWeight="Bold" Foreground="#FFB800"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- 6. Defender & Update -->
                        <RadioButton x:Name="NavDefender" Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked">
                            <Grid Width="185">
                                <TextBlock Text="🛡️ Defender &amp; Update" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <Border x:Name="BadgeDefender" HorizontalAlignment="Right" Background="#112B1C" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBadgeDefender" Text="SEGURO" FontSize="9" FontWeight="Bold" Foreground="#00FF66"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- 7. Scanner Gargalos -->
                        <RadioButton x:Name="NavScanner" Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked">
                            <Grid Width="185">
                                <TextBlock Text="🩺 Scanner Gargalos" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <Border x:Name="BadgeScanner" HorizontalAlignment="Right" Background="#112B1C" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBadgeScanner" Text="100%" FontSize="9" FontWeight="Bold" Foreground="#00FF66"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- 8. Documentação -->
                        <RadioButton x:Name="NavDocs" Style="{StaticResource SidebarNavButton}" Checked="Nav_Checked">
                            <Grid Width="185">
                                <TextBlock Text="📋 Documentação" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <Border x:Name="BadgeDocs" HorizontalAlignment="Right" Background="#141A26" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtBadgeDocs" Text="GUIA" FontSize="9" FontWeight="Bold" Foreground="#8B949E"/>
                                </Border>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ÁREA DE CARDS DINÂMICOS -->
            <Grid Grid.Column="1" Margin="14">
                
                <!-- PAINEL 1: GERAL & KERNEL SUPREMO -->
                <ScrollViewer x:Name="TabSupreme" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Banner 1-Clique Mestre -->
                        <Border Background="#0C1522" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⚡ PROTOCOLO SUPREMO DE OTIMIZAÇÃO (UNIVERSAL)" FontSize="14" FontWeight="Bold" Foreground="#00FF66"/>
                                    <TextBlock Text="Desempenho Máximo, Unpark 100% CPU, Win32Priority 40, MSI Mode, MPO Off, Cache NTFS RAM e Mouse 1:1." 
                                               FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,2,14,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="EXECUTAR SUPREMO (1-CLIQUE)" Style="{StaticResource CheatNeonButton}" FontSize="12" Padding="16,10" Click="BtnSupremeOptimization_Click"/>
                            </Grid>
                        </Border>

                        <!-- Grade de Cards -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUNA 1 -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Processador &amp; Foco de Tarefas" FontSize="13" FontWeight="Bold" Foreground="#00FF66" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkPowerPlan" Content="Plano de Energia: Desempenho Máximo" Style="{StaticResource CheatToggleSwitch}" Margin="0,0,0,8" Click="TogglePowerPlan_Click"/>
                                        <CheckBox x:Name="ChkUnparkCpu" Content="Desestacionar 100% dos Núcleos (Unpark CPU)" Style="{StaticResource CheatToggleSwitch}" Margin="0,0,0,8" Click="ToggleUnparkCpu_Click"/>
                                        <CheckBox x:Name="ChkWin32Prio" Content="Win32PrioritySeparation 40 (Foco no Jogo)" Style="{StaticResource CheatToggleSwitch}" Margin="0,0,0,8" Click="ToggleWin32Prio_Click"/>
                                        <CheckBox x:Name="ChkSvcHost" Content="Isolamento de Processos SvcHost Split" Style="{StaticResource CheatToggleSwitch}" Margin="0,0,0,4" Click="ToggleSvcHost_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="🖥️ Placa de Vídeo &amp; Telas 240Hz" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkMpo" Content="Desativar MPO (Fim dos Stutters Dual Screen)" Style="{StaticResource CyanToggleSwitch}" Margin="0,0,0,8" Click="ToggleMpo_Click"/>
                                        <CheckBox x:Name="ChkMsi" Content="Modo MSI (Message Signaled Interrupts) GPU" Style="{StaticResource CyanToggleSwitch}" Margin="0,0,0,8" Click="ToggleMsi_Click"/>
                                        <CheckBox x:Name="ChkNvidiaTweaks" Content="NVIDIA Tweaks (Preemption Off &amp; HAGS Mode)" Style="{StaticResource CyanToggleSwitch}" Margin="0,0,0,8" Click="ToggleNvidiaTweaks_Click"/>
                                        <CheckBox x:Name="ChkMmcss" Content="MMCSS Games GPU Priority 8 &amp; SFIO High" Style="{StaticResource CyanToggleSwitch}" Margin="0,0,0,4" Click="ToggleMmcss_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- COLUNA 2 -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <!-- Card Memória RAM Inteligente (Novo baseado na pasta base) -->
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="🧠 Otimização de Memória RAM Inteligente" FontSize="13" FontWeight="Bold" Foreground="#00FF66"/>
                                            <TextBlock x:Name="TxtRamStatusBadge" Text="Auto-Detectado" HorizontalAlignment="Right" FontSize="10" Foreground="#00E5FF"/>
                                        </Grid>
                                        <TextBlock Text="Ajuste fino de SvcHost Split e Compressão de RAM de acordo com o tamanho exato da sua memória:" FontSize="10" Foreground="#8B949E" Margin="0,0,0,8"/>
                                        
                                        <UniformGrid Columns="4" Margin="0,0,0,8">
                                            <Button Content="8GB" Style="{StaticResource CheatDarkButton}" Margin="2" Click="BtnRamProfile_8GB_Click"/>
                                            <Button Content="16GB" Style="{StaticResource CheatDarkButton}" Margin="2" Click="BtnRamProfile_16GB_Click"/>
                                            <Button Content="32GB" Style="{StaticResource CheatNeonButton}" Margin="2" Click="BtnRamProfile_32GB_Click"/>
                                            <Button Content="64GB" Style="{StaticResource CheatDarkButton}" Margin="2" Click="BtnRamProfile_64GB_Click"/>
                                        </UniformGrid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="CHECAR STATUS RAM" Style="{StaticResource CheatCyanButton}" Margin="0,0,3,0" Click="BtnCheckRam_Click"/>
                                            <Button Grid.Column="1" Content="ESVAZIAR STANDBY RAM" Style="{StaticResource CheatNeonButton}" Margin="3,0,0,0" Click="BtnEmptyStandbyRam_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card Segurança e Restauração -->
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ Ponto de Restauração &amp; Segurança" FontSize="13" FontWeight="Bold" Foreground="#F3F4F6" Margin="0,0,0,6"/>
